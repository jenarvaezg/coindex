# Copy to keystore.properties (gitignored) after creating the keystore.
#
#   keytool -genkeypair -v -keystore ~/keys/coindex-release.jks \
#     -alias coindex -keyalg RSA -keysize 4096 -validity 10000
#
# KEEP THAT FILE AND ITS PASSWORDS FOREVER: an update signed with a different key cannot
# be installed over the previous one.
storeFile=/Users/you/keys/coindex-release.jks
storePassword=
keyAlias=coindex
keyPassword=
