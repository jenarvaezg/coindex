<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Las fotos del catálogo se precargan solas (#191), y sólo con red no medida: 22 MB de
         fotos que nadie ha pedido no salen de la tarifa de datos del coleccionista. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Coindex se distribuye por APK, así que se actualiza a sí misma. La instalación
         siempre la confirma el usuario: nada de esto instala en silencio. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- La notificación de una descarga en Descargas (#285). Sin ella, en API 33+ el shade
         se queda callado; el snackbar y el fichero siguen bastando. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Abrir and the download notification ask resolveActivity whether a viewer exists (#436).
         Without these, package visibility would always answer no on API 30+ even when Photos
         or a PDF reader is installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <application
        android:name=".CoindexApplication"
        android:label="Coindex"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coindex">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Coindex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
